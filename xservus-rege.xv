functio !communicatio.adloquium lege_ip_adloquium(~linea destinatio) iacit {
	proba {
		var ipv4 = crea(communicatio.adloquium_ipv4, destinatio);
		si (!ipv4^.portus) ipv4^.portus = ifr_portus_defaltus;
		responde ipv4 acsi (communicatio.adloquium);
	}
	proba {
		var ipv6 = crea(communicatio.adloquium_ipv6, destinatio);
		si (!ipv6^.portus) ipv6^.portus = ifr_portus_defaltus;
		responde ipv6 acsi (communicatio.adloquium);
	}
	nint portus = ifr_portus_defaltus;
	linea dominatus;
	var del = destinatio.reperi_ultimum(":");
	si (del >= 0) {
		dominatus = destinatio.fragmentum(0, del);
		portus = destinatio.fragmentum(del + 1, -1).ad_nint32();
		si (!portus || portus >= 0x10000) iace errores.efformatio_falsa;
	} alioqui dominatus = destinatio;
	proba {
		var adloq = communicatio.lege_adloquia(dominatus, portus, communicatio.adloquium_ipv4);
		si (!adloq^.longitudo) iace errores.rete_defectum, errores.rete_adloquium_nullum;
		responde adloq^[0];
	}
	proba {
		var adloq = communicatio.lege_adloquia(dominatus, portus, communicatio.adloquium_ipv6);
		si (!adloq^.longitudo) iace errores.rete_defectum, errores.rete_adloquium_nullum;
		responde adloq^[0];
	}
	iace errores.argumentum_falsum;
}
functio nihil ini() iacit {
	var arg = para_argumenta();
	ctx.cauda = contextus.crea_caudam_simplicem();
	ctx.finis = contextus.crea_signale();
	ctx.procede = sic;
	ctx.nomen_usoris_defaltum = "anonymous";
	ctx.clavis_usoris_defaltum = "";
	si (!ctx.finis || !ctx.cauda) iace errores.memoria_nulla;
	ctx.filum = ctx.cauda^.exeque_in_filo();
	si (!ctx.filum) iace errores.memoria_nulla;
	var smbl = repulsus.para_symbola(modulus(), repulsus.symbola.generis, "imperatum");
	per (var i : smbl^) {
		var nomen = smbl^[i]^.attributa^["imperatum"];
		repulsus.fabricatio_objectorum fab(smbl^[i] acsi (repulsus.symbolum_generis));
		var imp = fab.crea_exemplar();
		!imperatum imp1;
		imp1.contine((@imperatum)(imp.valor()));
		ctx.imperata.adde(nomen, imp1);
	}
	!communicatio.adloquium adloq;
	communicatio.securitas sec;
	logicum secure = non;
	si (arg^.longitudo <= 1) {
		con.scribe(lineae.adloquium);
		si (!imperata.decompone(con.lege_lineam(), arg^)) iace errores.argumentum_falsum;
		arg^.insere("", 0);
	}
	dum (sic) {
		si (arg^[1].fragmentum(0, 6) == "ifr://") {
			adloq = lege_ip_adloquium(arg^[1].fragmentum(6, -1));
			per (int i = 2; i < arg^.longitudo; i++) {
				si (arg^[i].fragmentum(0, 5) == "usor=") ctx.nomen_usoris_defaltum = arg^[i].fragmentum(5, -1);
				alioqui si (arg^[i].fragmentum(0, 7) == "clavis=") ctx.clavis_usoris_defaltum = arg^[i].fragmentum(7, -1);
				alioqui iace errores.argumentum_falsum;
			}
			exi;
		} alioqui si (arg^[1].fragmentum(0, 7) == "ifrs://") {
			adloq = lege_ip_adloquium(arg^[1].fragmentum(7, -1));
			secure = sic;
			sec.neglege = non;
			per (int i = 2; i < arg^.longitudo; i++) {
				si (arg^[i].fragmentum(0, 5) == "usor=") ctx.nomen_usoris_defaltum = arg^[i].fragmentum(5, -1);
				alioqui si (arg^[i].fragmentum(0, 7) == "clavis=") ctx.clavis_usoris_defaltum = arg^[i].fragmentum(7, -1);
				alioqui si (arg^[i].fragmentum(0, 10) == "dominatus=") sec.dominatus = arg^[i].fragmentum(10, -1);
				alioqui si (arg^[i].fragmentum(0, 13) == "certificatus=") sec.certificatus = semita(arg^[i].fragmentum(13, -1)).crea_limam(modus_limae.legere, modus_creatoris.aperi_praesens)^.lege_ordinem();
				alioqui si (arg^[i] == "neglege") sec.neglege = sic;
				alioqui iace errores.argumentum_falsum;
			}
			exi;
		} alioqui si (arg^[1].fragmentum(0, 7) == "ifrl://") {
			adloq.contine(crea(communicatio.adloquium_localis, arg^[1].fragmentum(7, -1)));
			per (int i = 2; i < arg^.longitudo; i++) {
				si (arg^[i].fragmentum(0, 5) == "usor=") ctx.nomen_usoris_defaltum = arg^[i].fragmentum(5, -1);
				alioqui si (arg^[i].fragmentum(0, 7) == "clavis=") ctx.clavis_usoris_defaltum = arg^[i].fragmentum(7, -1);
				alioqui iace errores.argumentum_falsum;
			}
			exi;
		} alioqui {
			var dec = scriptio.decodifica(semita(arg^[1]).crea_limam(modus_limae.legere, modus_creatoris.aperi_praesens));
			si (!imperata.decompone(dec^.lege_lineam(), arg^)) iace errores.argumentum_falsum;
			arg^.insere("", 0);
			dum (!dec^.finis) {
				var i = dec^.lege_lineam();
				si (i.longitudo) ctx.autoexec.adde(i);
			}
		}
	}
	var canale = communicatio.crea_canale();
	si (secure) canale^.conjunge_synchrone(adloq^, sec); alioqui canale^.conjunge_synchrone(adloq^);
	ctx.servus = crea(remota.servus, canale, ctx.cauda);
	ctx.servus^.labos_closionis = contextus.labos ## { ctx.finis^.erige(); };
	ctx.servus^.exeque();
}
functio nihil finaliza() iacit {
	si (ctx.servus) ctx.servus^.clode();
	si (ctx.cauda) ctx.cauda^.linque();
	si (ctx.filum) ctx.filum^.opperire();
}
functio nihil _() introitus iacit {
	proba {
		ini();
		dum (ctx.procede && !ctx.finis^.opperire(0)) {
			con.color_primus = consolatorium.color.flavus;
			con.scribe(ctx.quaesitum);
			con.color_primus = ctx.autoexec.longitudo ? consolatorium.color.blavius : consolatorium.color.viridis;
			con.scribe(" > ");
			con.color_primus = consolatorium.color.defalta;
			linea imp;
			si (ctx.autoexec.longitudo) {
				imp = ctx.autoexec[0];
				ctx.autoexec.remove_primum();
				con.scribe_lineam(imp);
			} alioqui {

				// TODO: MODERNIZE INPUT
				imp = con.lege_lineam();

			}
			proba {
				dordo_linearum impa;
				si (!imperata.decompone(imp, impa)) dura;
				var imp0 = ctx.imperata[impa[0]];
				si (imp0 == nullus) iace errores.implantatio_nulla;
				imp0^^.exeque(impa);
			} cape (nintadl e, nintadl se) {
				linea de, dse;
				con.modus_currens = consolatorium.modus.repulsus;
				con.color_primus = consolatorium.color.ruber;
				errores.descriptio(e, se, de, dse);
				con.scribe(lineae.error_imperati);
				con.scribe(": " + de);
				si (dse.longitudo) con.scribe(" - " + dse);
				con.scribe_lineam();
				con.color_primus = consolatorium.color.defalta;
			}
		}
		si (ctx.finis^.opperire(0)) {
			con.color_primus = consolatorium.color.flavus;
			con.scribe_lineam(lineae.servus_closus);
			con.color_primus = consolatorium.color.defalta;
		}
		finaliza();
	} cape (nintadl e, nintadl se) {
		linea de, dse;
		con.modus_currens = consolatorium.modus.repulsus;
		con.color_primus = consolatorium.color.ruber;
		errores.descriptio(e, se, de, dse);
		con.scribe_lineam();
		con.scribe(lineae.error_communalis);
		con.scribe(": " + de);
		si (dse.longitudo) con.scribe(" - " + dse);
		con.scribe_lineam();
		con.color_primus = consolatorium.color.defalta;
		finaliza();
		iace e, se;
	}
}