constatus ifr_portus_defaltus = nint(10666);
var ~consolatorium con = consolatorium.currens()^;
spatium lineae {
	constatus adloquium = "Adloquium: "
		{ "ru", "Адрес сервера: " }
		{ "en", "Server address: " };
	constatus error_communalis = "ERROR COMMUNALIS"
		{ "ru", "ОБЩАЯ ОШИБКА ИСПОЛНЕНИЯ" }
		{ "en", "COMMON EXECUTION ERROR" };
	constatus error_imperati = "Error imperati"
		{ "ru", "Ошибка исполнения команды" }
		{ "en", "Command execution error" };
	constatus servus_closus = "Servus closus est."
		{ "ru", "Сервер был закрыт." }
		{ "en", "The server was closed." };
	constatus servus_sl_nulla = "Servus systemae limarum nullus."
		{ "ru", "Служба удалённой файловой системы не поддерживается." }
		{ "en", "The remote file system service is not available." };
	constatus servus_rs_nulla = "Servus rectionis ab servo nullus."
		{ "ru", "Служба управления сервером не поддерживается." }
		{ "en", "The server control service is not available." };
	constatus permissiones_sl = "Permissiones per locatione '%0' : %1."
		{ "ru", "Права на расположение '%0' : %1." }
		{ "en", "Permissions for location '%0' : %1." };
	constatus permissiones_rs = "Permissiones per servo : %0."
		{ "ru", "Права на сервер : %0." }
		{ "en", "Permissions for server : %0." };
	constatus status_energiae_praecipiens = "Accumulator praecipiens est, %0%%."
		{ "ru", "Аккумулятор заряжается, заряд %0%%." }
		{ "en", "The battery is charging, charge %0%%." };
	constatus status_energiae_depraecipiens = "Accumulator depraecipiens est, %0%%."
		{ "ru", "Аккумулятор разряжается, заряд %0%%." }
		{ "en", "The battery is discharging, charge %0%%." };
	constatus status_energiae_accumulator_nullus = "Energia ex rete."
		{ "ru", "Сетевой источник питания." }
		{ "en", "The line power source is used." };
}

genus imperatum hereditat objectum {
	structor () {}
	functio nihil exeque(~dordo_linearum imperatum) iacit virtualis pura;
	functio ordo linea ende(~dordo_linearum imperatum, logicum argumentum_novum) iacit virtualis pura;
}
genus collectorium hereditat objectum {
	!collectiones.dictionarium[linea, !remota.systema_limarum.locatio] _radices;
	ordo !collectorium _parentes;
	!remota.systema_limarum.locatio _ego;
	linea _semita;

	functio nihil _decompone(~linea semita, ~linea nomen, ~!collectorium col) iacit {
		var del = semita.reperi_ultimum("/");
		si (del >= 0) {
			col = aperi_locationem(semita.fragmentum(0, del + 1));
			nomen = semita.fragmentum(del + 1, -1);
		} alioqui {
			col.contine(ego);
			nomen = semita;
		}
	}
	structor (~ordo !remota.systema_limarum.locatio rdx) iacit {
		_radices = crea(_radices.genus_objectum);
		per (var i : rdx) _radices^.adde(rdx[i]^.nomen, rdx[i]);
		_semita = "/";
	}
	structor (~!collectorium parens, ~linea filius) iacit {
		funda _radices(parens^._radices);
		funda _parentes(parens^._parentes);
		_parentes.adde(parens);
		si (parens^._ego) {
			_ego = parens^._ego^.aperi_locationem(filius, parens^._ego^.modus);
			_semita = parens^._semita + "/" + filius;
		} alioqui si (parens^._radices) {
			var sub = parens^._radices^[filius];
			si (sub == nullus) iace errores.ie_falsum, errores.ie_semita_nulla;
			_ego = sub^;
			_semita = "/" + filius;
		} alioqui iace errores.habitus_falsus;
	}
	linea semita { adipisce iacit { responde _semita; } }
	nint modus { adipisce iacit { responde _ego ? _ego^.modus : 7; } }
	!collectorium parens { adipisce iacit { si (_parentes.longitudo) responde _parentes.ultimus(); iace errores.ie_falsum, errores.ie_semita_nulla; } }
	(nint64, nint64, nint64) quota { adipisce iacit { si (_ego) responde _ego^.quota; iace errores.implantatio_nulla; } }
	ordo (linea, nint) filii { adipisce iacit {
		si (_ego) responde _ego^.filii;
		ordo (linea, nint) r;
		si (_radices) per (var v : _radices^) r << (v^.valor.primus, remota.systema_limarum.genus_objecti.collectorium);
		responde r;
	} }
	functio !collectorium aperi_locationem(~linea nomen) iacit {
		!collectorium currens;
		si (nomen[0] == '/' && _parentes.longitudo) currens = _parentes[0];
		alioqui currens.contine(ego);
		var n = nomen.scinde('/');
		per (var i : n^) {
			var sn = n^[i];
			si (!sn.longitudo || sn == ".") dura;
			si (sn == "..") currens = currens^.parens;
			alioqui currens = crea(collectorium, currens, sn);
		}
		responde currens;
	}
	functio !remota.systema_limarum.lima aperi_limam(~linea nomen, nint modus) iacit {
		var lim = nomen.reperi_ultimum("/");
		si (lim >= 0) {
			var col = aperi_locationem(nomen.fragmentum(0, lim + 1));
			responde col^.aperi_limam(nomen.fragmentum(lim + 1, -1), modus);
		} alioqui si (_ego) {
			responde _ego^.aperi_limam(nomen, modus);
		} alioqui iace errores.ie_falsum, errores.ie_lima_nulla;
	}
	functio nihil crea_collectorium(~linea nomen) iacit {
		!collectorium col; linea nom;
		_decompone(nomen, nom, col);
		si (!col^._ego) iace errores.implantatio_nulla;
		col^._ego^.crea_filium(nom, remota.systema_limarum.genus_objecti.collectorium);
	}
	functio nihil crea_limam(~linea nomen) iacit {
		!collectorium col; linea nom;
		_decompone(nomen, nom, col);
		si (!col^._ego) iace errores.implantatio_nulla;
		col^._ego^.crea_filium(nom, remota.systema_limarum.genus_objecti.lima);
	}
	functio nihil move_filium(~linea nomen, ~linea nomen_novum) iacit {
		!collectorium col_de, col_ad; linea nom_de, nom_ad;
		_decompone(nomen, nom_de, col_de);
		_decompone(nomen_novum, nom_ad, col_ad);
		si (!col_de^._ego || !col_ad^._ego) iace errores.implantatio_nulla;
		col_de^._ego^.move_filium(nom_de, nom_ad, col_ad^._ego);
	}
	functio nihil remove_filium(~linea nomen) iacit {
		!collectorium col; linea nom;
		_decompone(nomen, nom, col);
		si (!col^._ego) iace errores.implantatio_nulla;
		col^._ego^.remove_filium(nom);
	}
}
structura contextus_rectoris {
	!contextus.cauda_simplex cauda;
	!contextus.filum filum;
	!contextus.signale finis;
	!remota.servus servus;
	!remota.xservus.servus rs;
	ordo !remota.systema_limarum.locatio sl;
	collectiones.dictionarium[linea, !imperatum] imperata;
	logicum procede;
	linea quaesitum;
	linea nomen_usoris_defaltum;
	linea clavis_usoris_defaltum;
	!collectorium collectorium_currens;
	ordo linea autoexec;

	// TODO: ADDE HISTORIAM / CONTEXTUS INPONENDI

}
var contextus_rectoris ctx;

spatium enumeratores {
	structura enumerator_limarum_remotarum {
		ordo (!collectorium, linea, linea, nint) _cauda; // locatio, nomen locale, subsemita, genus
		structor () {}
		structor (~!collectorium currens, ~linea semita) iacit {
			!collectorium col; linea nom;
			currens^._decompone(semita, nom, col);
			nint go = remota.systema_limarum.genus_objecti.ignotus;
			var filii = col^.filii;
			per (var i : filii) si (filii[i].primus == nom) { go = filii[i].secundus; exi; }
			_cauda.adde((col, nom, linea(), go));
		}
		functio ~enumerator_limarum_remotarum operator ++ () iacit {
			si (_cauda.longitudo) {
				si (_cauda[0].quartus == remota.systema_limarum.genus_objecti.collectorium) {
					var col = _cauda[0].primus^.aperi_locationem(_cauda[0].secundus);
					var filii = col^.filii;
					per (var i : filii) _cauda << (col, filii[i].primus, _cauda[0].tertius + "/" + filii[i].primus, filii[i].secundus);
				}
				_cauda.remove_primum();
			}
			responde ego^;
		}
		classis functio logicum operator != (~enumerator_limarum_remotarum a, ~enumerator_limarum_remotarum b) { responde a._cauda.longitudo || b._cauda.longitudo; }
		(!collectorium, linea, linea, nint) valor { adipisce iacit { si (!_cauda.longitudo) iace errores.habitus_falsus; responde _cauda.primus(); } }
	}
	structura enumerator_limarum_localium {
		ordo (semita, linea, nint) _cauda; // semita, subsemita, genus
		structor () {}
		structor (~semita sem) iacit {
			si (sem.collectorium_est) _cauda.adde((sem, linea(), remota.systema_limarum.genus_objecti.collectorium));
			alioqui si (sem.lima_est) _cauda.adde((sem, linea(), remota.systema_limarum.genus_objecti.lima));
		}
		functio ~enumerator_limarum_localium operator ++ () iacit {
			si (_cauda.longitudo) {
				si (_cauda[0].tertius == remota.systema_limarum.genus_objecti.collectorium) {
					var collectoria = _cauda[0].primus.collectoria();
					var limae = _cauda[0].primus.limae();
					per (var i : collectoria^) {
						semita s(collectoria^[i]);
						_cauda.adde((s, _cauda[0].secundus + "/" + s.nomen, remota.systema_limarum.genus_objecti.collectorium));
					}
					per (var i : limae^) {
						semita s(limae^[i]);
						_cauda.adde((s, _cauda[0].secundus + "/" + s.nomen, remota.systema_limarum.genus_objecti.lima));
					}
				}
				_cauda.remove_primum();
			}
			responde ego^;
		}
		classis functio logicum operator != (~enumerator_limarum_localium a, ~enumerator_limarum_localium b) { responde a._cauda.longitudo || b._cauda.longitudo; }
		(semita, linea, nint) valor { adipisce iacit { si (!_cauda.longitudo) iace errores.habitus_falsus; responde _cauda.primus(); } }
	}
	genus dorsum_remotum {
		!collectorium _currens; linea _semita;
		structor (~!collectorium currens, ~linea semita) iacit { funda _currens(currens); funda _semita(semita); }
		functio enumerator_limarum_remotarum initus() iacit { responde enumerator_limarum_remotarum(_currens, _semita); }
		functio enumerator_limarum_remotarum post_finis() iacit { responde enumerator_limarum_remotarum(); }
	}
	genus dorsum_locale {
		semita _semita;
		structor (~semita sem) iacit { funda _semita(sem); }
		functio enumerator_limarum_localium initus() iacit { responde enumerator_limarum_localium(_semita); }
		functio enumerator_limarum_localium post_finis() iacit { responde enumerator_limarum_localium(); }
	}
}
spatium imperata {
	functio logicum _lege_argumetum(~linea in, ~int pos, int long, ~linea arg) iacit
	{
		dum (pos < long && (in[pos] == ' ' || in[pos] == '\t')) pos++;
		si (pos >= long) responde non;
		si (in[pos] == '\'') {
			ordo char acc;
			pos++;
			dum (pos < long) {
				si (in[pos] == '\'') {
					pos++;
					si (in[pos] == '\'') {
						acc.adde(in[pos]);
						pos++;
					} alioqui exi;
				} alioqui {
					acc.adde(in[pos]);
					pos++;
				}
			}
			arg = linea(acc.data, acc.longitudo, linea.codex.utf32);
		} alioqui {
			int i = pos;
			dum (pos < long && in[pos] != ' ' && in[pos] != '\t') pos++;
			arg = in.fragmentum(i, pos - i);
		}
		responde sic;
	}
	functio logicum decompone(~linea in, ~dordo_linearum imperatum)
	{
		proba {
			int pos = 0;
			int long = in.longitudo;
			imperatum.depura();
			logicum lectum = sic;
			dum (lectum) {
				linea arg;
				lectum = _lege_argumetum(in, pos, long, arg);
				si (lectum) imperatum.adde(arg);
			}
			responde imperatum.longitudo > 0;
		} cape responde non;
	}
	functio ordo linea ende(~dordo_linearum imperatum, logicum argumentum_novum) iacit {

		// TODO: IMPLEMENT
		iace errores.implantatio_nulla;

	}
	spatium implantationes {
		["imperatum" "authoriza"]
		structura authoriza hereditat imperatum {
			functio nihil exeque(~dordo_linearum imperatum) iacit redefini {
				linea nomen = imperatum.longitudo > 1 ? imperatum[1] : ctx.nomen_usoris_defaltum;
				linea clavis = imperatum.longitudo > 2 ? imperatum[2] : ctx.clavis_usoris_defaltum;
				!remota.systema_limarum.authorizator sl_auth;
				!remota.xservus.authorizator rs_auth;
				proba sl_auth = remota.crea_exemplar(ctx.servus, remota.systema_limarum.authorizator) acsi (remota.systema_limarum.authorizator);
				proba rs_auth = remota.crea_exemplar(ctx.servus, remota.xservus.authorizator) acsi (remota.xservus.authorizator);
				ctx.sl.depura();
				ctx.rs.depura();
				ctx.collectorium_currens.depura();
				ctx.quaesitum = "";
				si (sl_auth) {
					ctx.sl = sl_auth^.authoriza(nomen, clavis);
					si (ctx.sl.longitudo > 0) {
						ctx.collectorium_currens = crea(collectorium, ctx.sl);
						ctx.quaesitum = ctx.collectorium_currens^.semita;
					}
				} alioqui {
					con.color_primus = consolatorium.color.flavus;
					con.scribe_lineam(lineae.servus_sl_nulla);
					con.color_primus = consolatorium.color.defalta;
				}
				si (rs_auth) {
					ctx.rs = rs_auth^.authoriza(nomen, clavis);
				} alioqui {
					con.color_primus = consolatorium.color.flavus;
					con.scribe_lineam(lineae.servus_rs_nulla);
					con.color_primus = consolatorium.color.defalta;
				}
			}
			functio ordo linea ende(~dordo_linearum imperatum, logicum argumentum_novum) iacit redefini {

				// TODO: IMPLEMENT
				iace errores.implantatio_nulla;

			}
		}
		["imperatum" "exi"]
		structura exire hereditat imperatum {
			functio nihil exeque(~dordo_linearum imperatum) iacit redefini { ctx.procede = non; }
			functio ordo linea ende(~dordo_linearum imperatum, logicum argumentum_novum) iacit redefini {

				// TODO: IMPLEMENT
				iace errores.implantatio_nulla;

			}
		}
		["imperatum" "depura"]
		structura depura hereditat imperatum {
			functio nihil exeque(~dordo_linearum imperatum) iacit redefini {
				si (imperatum.longitudo > 1 && imperatum[1] == "fundum") con acsi (xx.xc)^.retexe_imaginem_fundi();
				alioqui con.depura_cunctum();
			}
			functio ordo linea ende(~dordo_linearum imperatum, logicum argumentum_novum) iacit redefini {

				// TODO: IMPLEMENT
				iace errores.implantatio_nulla;

			}
		}
		["imperatum" "persiste"]
		structura persiste hereditat imperatum {
			functio nihil exeque(~dordo_linearum imperatum) iacit redefini { con acsi (xx.xc)^.clode_fenestram = non; }
			functio ordo linea ende(~dordo_linearum imperatum, logicum argumentum_novum) iacit redefini {

				// TODO: IMPLEMENT
				iace errores.implantatio_nulla;

			}
		}
		["imperatum" "permissiones"]
		structura permissiones hereditat imperatum {
			functio linea _permissiones(nint valor) iacit {
				linea r;
				si (valor & modus_limae.legere) r += "R"; alioqui r += "-";
				si (valor & modus_limae.scribere) r += "W"; alioqui r += "-";
				si (valor & modus_limae.exequi) r += "X"; alioqui r += "-";
				responde r;
			}
			functio nihil exeque(~dordo_linearum imperatum) iacit redefini {
				per (var i : ctx.sl) {
					con.scribe_lineam(linea.forma(lineae.permissiones_sl, ctx.sl[i]^.nomen, _permissiones(ctx.sl[i]^.modus)));
				}
				si (ctx.rs) {
					con.scribe_lineam(linea.forma(lineae.permissiones_rs, _permissiones(ctx.rs^.permissiones)));
				}
			}
			functio ordo linea ende(~dordo_linearum imperatum, logicum argumentum_novum) iacit redefini {

				// TODO: IMPLEMENT
				iace errores.implantatio_nulla;

			}
		}
		["imperatum" "siste"]
		structura siste hereditat imperatum {
			functio nihil exeque(~dordo_linearum imperatum) iacit redefini {
				si (!ctx.rs) iace errores.habitus_falsus;
				var machinam = imperatum.longitudo > 1 && imperatum[1] == "machinam";
				si (machinam) ctx.rs^.siste_systemam(); alioqui ctx.rs^.siste_servum();
				ctx.procede = non;
			}
			functio ordo linea ende(~dordo_linearum imperatum, logicum argumentum_novum) iacit redefini {

				// TODO: IMPLEMENT
				iace errores.implantatio_nulla;

			}
		}
		["imperatum" "recipe"]
		structura recipe hereditat imperatum {
			functio nihil exeque(~dordo_linearum imperatum) iacit redefini {
				si (!ctx.rs) iace errores.habitus_falsus;
				var machinam = imperatum.longitudo > 1 && imperatum[1] == "machinam";
				si (machinam) ctx.rs^.recipe_systemam(); alioqui ctx.rs^.recipe_servum();
				ctx.procede = non;
			}
			functio ordo linea ende(~dordo_linearum imperatum, logicum argumentum_novum) iacit redefini {

				// TODO: IMPLEMENT
				iace errores.implantatio_nulla;

			}
		}
		["imperatum" "status"]
		structura status hereditat imperatum {
			functio nihil scribe_extensiones(~remota.xservus.status_servi ss, int parens, ~linea praev) iacit {
				per (var i : ss.extensiones) {
					var ~ e = ss.extensiones[i];
					si (e.numerus_parentis == parens) {
						con.color_primus = consolatorium.color.purpureus;
						con.scribe(praev + e.nomen_classis);
						con.color_primus = consolatorium.color.griseus_tenebrosus;
						con.scribe_lineam(":");
						con.color_primus = consolatorium.color.defalta;
						per (var j : e.argumenta) {
							con.color_primus = consolatorium.color.lazulinus;
							con.scribe(praev + "  " + e.argumenta[j].primus);
							con.color_primus = consolatorium.color.griseus_tenebrosus;
							con.scribe(" = ");
							con.color_primus = consolatorium.color.viridis;
							con.scribe_lineam(e.argumenta[j].secundus);
							con.color_primus = consolatorium.color.defalta;
						}
						scribe_extensiones(ss, i, praev + "  ");
					}
				}
			}
			functio nihil exeque(~dordo_linearum imperatum) iacit redefini
			{
				si (!ctx.rs) iace errores.habitus_falsus;
				var status = ctx.rs^.status;
				si (status.potentia > 0) {
					con.color_primus = consolatorium.color.viridis;
					con.scribe_lineam(linea.forma(lineae.status_energiae_praecipiens, int(status.valor_praecipiendi)));
					con.color_primus = consolatorium.color.defalta;
				} alioqui si (status.potentia < 0) {
					con.color_primus = consolatorium.color.flavus;
					con.scribe_lineam(linea.forma(lineae.status_energiae_depraecipiens, int(status.valor_praecipiendi)));
					con.color_primus = consolatorium.color.defalta;
				} alioqui con.scribe_lineam(lineae.status_energiae_accumulator_nullus);
				scribe_extensiones(status, -1, "");
			}
			functio ordo linea ende(~dordo_linearum imperatum, logicum argumentum_novum) iacit redefini {

				// TODO: IMPLEMENT
				iace errores.implantatio_nulla;

			}
		}
		["imperatum" "usores"]
		structura usores hereditat imperatum {
			functio nihil exeque(~dordo_linearum imperatum) iacit redefini
			{
				si (!ctx.rs) iace errores.habitus_falsus;
				si (imperatum.longitudo > 1 && imperatum[1] == "salva") ctx.rs^.salva_usores(); alioqui {
					var u = ctx.rs^.usores;
					per (var i : u) con.scribe_lineam(u[i]);
