		["imperatum" "ls"]
		structura ls hereditat imperatum {
			classis functio linea _lnmd(nint modus) iacit {
				linea r;
				si (modus & modus_limae.legere) r += "r"; alioqui r += "-";
				si (modus & modus_limae.scribere) r += "w"; alioqui r += "-";
				si (modus & modus_limae.exequi) r += "x"; alioqui r += "-";
				responde r;
			}
			classis functio nihil _scribe_tabulationem(~ordo linea tab, ~ordo consolatorium.color colores, nint ncol) iacit {
				si (tab.longitudo != colores.longitudo) iace errores.argumentum_falsum;
				ordo nint clat;
				nint nlin = tab.longitudo / ncol;
				per (var c : [0, ncol - 1]) {
					nint mx = 0;
					per (var i : [0, nlin - 1]) {
						var long = tab[c + i * ncol].longitudo;
						si (long > mx) mx = long;
					}
					clat << mx;
				}
				per (var j : [0, nlin - 1]) {
					per (var i : [0, ncol - 1]) {
						nint k = i + j * ncol;
						con.color_primus = colores[k];
						si (i == 1) con.scribe(linea(' ', clat[i] - tab[k].longitudo));
						con.scribe(tab[k]);
						si (i != 1) con.scribe(linea(' ', clat[i] - tab[k].longitudo));
						si (i == ncol - 1) con.scribe_lineam(); alioqui con.scribe(" ");
					}
				}
				con.color_primus = consolatorium.color.defalta;
			}
			functio nihil exeque(~dordo_linearum imperatum) iacit redefini
			{
				si (!ctx.collectorium_currens) iace errores.habitus_falsus;
				!collectorium currens;
				si (imperatum.longitudo > 1) currens = ctx.collectorium_currens^.aperi_locationem(imperatum[1]);
				alioqui currens = ctx.collectorium_currens;
				var filii = currens^.filii;
				ordo linea tab;
				ordo consolatorium.color clr;
				per (var i : filii) {
					si (filii[i].secundus == remota.systema_limarum.genus_objecti.lima) {
						proba {
							var lima = currens^.aperi_limam(filii[i].primus, 0);
							var modus = lima^.permissiones;
							var tempus = lima^.tempi.secundus;
							var longitudo = lima^.longitudo;
							tab << ("-" + _lnmd(modus.primus) + _lnmd(modus.secundus) + _lnmd(modus.tertius));
							tab << linea(longitudo);
							tab << tempus.ad_lineam();
							tab << filii[i].primus;
							clr << consolatorium.color(consolatorium.color.defalta) << consolatorium.color(consolatorium.color.albus) << consolatorium.color(consolatorium.color.flavus);
						} cape {
							tab << ("----------");
							tab << "-";
							tab << "-";
							tab << filii[i].primus;
							clr << consolatorium.color(consolatorium.color.ruber) << consolatorium.color(consolatorium.color.ruber) << consolatorium.color(consolatorium.color.ruber);
						}
						clr << consolatorium.color(consolatorium.color.albus);
					} alioqui si (filii[i].secundus == remota.systema_limarum.genus_objecti.collectorium) {
						proba {
							var col = currens^.aperi_locationem(filii[i].primus);
							var md = col^.modus;
							tab << ("d" + _lnmd(md) + _lnmd(0) + _lnmd(0));
							tab << "-";
							tab << "-";
							tab << filii[i].primus;
							clr << consolatorium.color(consolatorium.color.defalta) << consolatorium.color(consolatorium.color.griseus_tenebrosus) << consolatorium.color(consolatorium.color.griseus_tenebrosus);
						} cape {
							tab << ("d---------");
							tab << "-";
							tab << "-";
							tab << filii[i].primus;
							clr << consolatorium.color(consolatorium.color.ruber) << consolatorium.color(consolatorium.color.ruber) << consolatorium.color(consolatorium.color.ruber);
						}
						clr << consolatorium.color(consolatorium.color.lazulinus);
					} alioqui {
						tab << ("?---------");
						tab << "-";
						tab << "-";
						tab << filii[i].primus;
						clr << consolatorium.color(consolatorium.color.griseus_tenebrosus) << consolatorium.color(consolatorium.color.griseus_tenebrosus) << consolatorium.color(consolatorium.color.griseus_tenebrosus) << consolatorium.color(consolatorium.color.griseus_tenebrosus);
					}
				}
				_scribe_tabulationem(tab, clr, 4);
			}
			functio ordo linea ende(~dordo_linearum imperatum, logicum argumentum_novum) iacit redefini {

				// TODO: IMPLEMENT
				iace errores.implantatio_nulla;

			}
		}
